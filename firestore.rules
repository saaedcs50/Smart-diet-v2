// ============================================================================
// قواعد أمان Firestore — المرحلة الثانية من بناء المنصة
// ----------------------------------------------------------------------------
// حالة النشر: قواعد Firestore نُشرت على المشروع التجريبي
// smart-diet-platform-trial في 2026-10-24 (من وحدة التحكم/CLI، لا من بيئة
// البناء هذه). قواعد Storage ما زالت غير منشورة — معلقة على قرار ترقية
// Blaze للمشروع التجريبي. أي تعديل لاحق على هذا الملف يحتاج إعادة نشر
// يدوي (انظر firestore.rules.test.md) — التعديلات الحالية في هذا الملف
// بانتظار ذلك النشر.
// إنشاء مستند المريض: مسموح للمريض نفسه فقط أثناء التسجيل بالدعوة
// ولعيادته نفسها حصرًا (انظر allow create في match /patients/{pid}).
//
// انحراف موثق عن دراسة §٥ (مقصود، كما في المرحلة الأولى):
// دراسة §٥ تفترض أن الدور والعيادة يأتيان من claims مخصصة في ID token.
// هذه المرحلة تستخدم مستند المستخدم `users/{uid}` كمصدر للدور (role +
// clinicId) لأن منح الـ claims يتطلب Cloud Function لم تُبنَ بعد. القواعد
// أدناه تمنع غير الأدمن من إنشاء/تعديل الدور أو العيادة، وتجعل الكتابة على
// سجل التدقيق مستحيلة من العميل. الانتقال إلى claims هو خطوة تقوية لاحقة
// ولا يغيّر سلوك القواعد من منظور العميل.
// تنبيه التمهيد (bootstrap): أول أدمن لا يملك مستند مستخدم بعد، لذلك لا
// يستطيع إنشاء أول حساب عبر القواعد؛ يُنشأ مستند الأدمن الأول من وحدة تحكم
// المشروع (Console) حصرًا، ثم يعمل كل شيء عبر القواعد.
//
// ما أضافته المرحلة الثانية:
// - دوال الدور محمية بوجود المستند (userExists): مستخدم بلا مستند مستخدم
//   (مثل مدعو حديث التسجيل قبل إنشاء ملفه) لا يُسبب خطأ تقييم في القواعد،
//   بل يُعامل كبلا دور ويُرفض — وهذا ما يجعل مسار الدعوة يعمل: إنشاء
//   مستند المستخدم عبر الدعوة لا يعتمد على role() أصلًا.
// - الدعوات: معرّف مستند الدعوة هو البريد المطبّع نفسه، لأن القواعد لا
//   تستطيع الاستعلام عن مجموعة بالبريد بل تقرأ مسارًا معروفًا فقط.
//   إنشاء مستند المستخدم مسموح للمدعو نفسه فقط عند مطابقة دعوة غير
//   مستهلكة لنفس البريد والدور والعيادة، وتُستهلك الدعوة بانتقال حالتها
//   pending → consumed. طاقم العيادة يستطيع إعادة دعوة مستهلكة إلى
//   pending (إعادة دعوة)، ولا يستطيع أحد حذف دعوة من العميل.
// مبادئ: الرفض هو الافتراضي؛ لا وصول متقاطع بين العيادات؛ الطبيب لا يرى
// إلا مرضى عيادته؛ الأدمن يدير عيادته فقط.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // مصدر الدور في هذه المرحلة: مستند المستخدم نفسه. الحماية بوجود
    // المستند مهمة: get() على مستند غير موجود يُخطئ التقييم كله، لذلك
    // تُستخدم exists() أولًا (والتقييم الكسول لـ ?: و&& يمنع استدعاء
    // get() عند عدم الوجود). مستخدم بلا مستند = بلا دور = مرفوض.
    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() { return userExists() ? userData().role : null; }
    function clinicId() { return userExists() ? userData().clinicId : null; }
    function isPatient() { return signedIn() && role() == 'patient'; }
    function isCoach() { return signedIn() && role() == 'coach'; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isStaff() { return isCoach() || isAdmin(); }

    function patientClinicId(pid) {
      return get(/databases/$(database)/documents/patients/$(pid)).data.clinicId;
    }

    // هل أول مقطع تحت المريض هو consents؟ تُستخدم لمنع كتابة الطاقم
    // على الموافقات عبر الممرر العام، لأن القواعد OR فيتجاوز allow write
    // العام قاعدة الموافقات الأضيق.
    // (المقطع يُمرر كمعامل لأن الدوال لا ترى متغيرات الـ match خارج نطاق تعريفها.)
    function isConsentSubpath(firstSegment) {
      return firstSegment == 'consents';
    }

    // --- الدعوات ------------------------------------------------------------
    // معرّف المستند = بريد المدعو المطبّع (صغير الحروف). بريد الـ Auth
    // token هو ما يُقارن به، لذلك يجب أن يسجّل المدعو بالبريد المطبّع
    // نفسه (انظر invitations.ts).
    function invitationExists() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email));
    }
    function invitationData() {
      return get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data;
    }
    // إنشاء مستند المستخدم عبر الدعوة: لا يعتمد على role() (المدعو بلا
    // مستند بعد)، بل على بريد الـ token ومطابقة الدعوة فقط.
    function invitationAllows(uid) {
      return signedIn() && request.auth.uid == uid && invitationExists()
        && invitationData().email == request.auth.token.email
        && invitationData().status == 'pending'
        && invitationData().role == request.resource.data.role
        && invitationData().clinicId == request.resource.data.clinicId;
    }

    // العيادة: القراءة لأعضائها، التعديل للأدمن فقط، لا إنشاء ولا حذف.
    match /clinics/{cid} {
      allow read: if signedIn() && clinicId() == cid;
      allow update: if isAdmin() && clinicId() == cid;
      allow create, delete: if false;
    }

    // سجل الحساب: صاحبه يقرأه، الطاقم يقرأ حسابات عيادته، الأدمن ينشئ
    // حسابات عيادته فقط ولا يستطيع تغيير دور أو عيادة موجودة.
    // جديد في المرحلة الثانية: المدعو نفسه ينشئ ملفه عند مطابقة دعوة.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || (isStaff() && resource.data.clinicId == clinicId()));
      allow create: if (isAdmin() && request.resource.data.clinicId == clinicId())
                    || invitationAllows(uid);
      allow update: if isAdmin() && clinicId() == resource.data.clinicId
                    && request.resource.data.clinicId == resource.data.clinicId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // الدعوات: قراءة لصاحبها أو طاقم عيادتها؛ إنشاء لطاقم عيادتها فقط
    // (الطبيب يدعو مرضى فقط، الأدمن يدعو أي دور)؛ استهلاك من المدعو نفسه
    // بتغيير الحالة فقط؛ إعادة دعوة من الطاقم؛ لا حذف أبدًا من العميل.
    match /invitations/{invId} {
      allow read: if signedIn() && (request.auth.token.email == resource.data.email
        || (isStaff() && resource.data.clinicId == clinicId()));
      allow create: if (isAdmin() && request.resource.data.clinicId == clinicId()
                     && request.resource.data.status == 'pending'
                     && invId == request.resource.data.email)
                    || (isCoach() && request.resource.data.clinicId == clinicId()
                     && request.resource.data.role == 'patient'
                     && request.resource.data.status == 'pending'
                     && invId == request.resource.data.email);
      // فرعان مستقلان بأقواس: استهلاك المدعو لدعوته، وإعادة فتح الطاقم.
      // المدعو لا يستطيع إعادة الفتح، والطاقم لا يغير الدور أو العيادة
      // أو البريد في التحديث (الحالة فقط في الحالتين).
      allow update: if (
                      signedIn()
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'consumed'
                      && request.auth.token.email == resource.data.email
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    ) || (
                      isStaff()
                      && resource.data.clinicId == clinicId()
                      && resource.data.status == 'consumed'
                      && request.resource.data.status == 'pending'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    );
      allow delete: if false;
    }

    // المريض وكل ما تحته: سقف واحد يغطي plan وdayLogs وكل المجموعات الفرعية.
    // ملاحظة حرجة: الممرر العام {doc=**} يطابق صفر مقطع أيضًا فيطابق مستند
    // المريض نفسه — لذلك النمط هنا {subcollection}/{doc=**} يتطلب مقطعًا
    // واحدًا على الأقل فيستبعد المستند الأب، وقواعده الخاصة في
    // match /patients/{pid} أدناه (الإنشاء المقيد للمريض نفسه).
    // استثناء: الموافقات (consents) — كتابة المريض وحده؛ كتابة الطاقم
    // عليها مرفوضة هنا حتى لا يتجاوز الممرر العام قاعدة الموافقات الأضيق.
    // مسارات الكود الحالية: plan وplanHistory وdayLogs وshoppingLists
    // وmilestones وseasonal وintakes وactiveFasting وnotificationSettings
    // وphotos — كلها غير consents فتبقى مسموحة للطاقم.
    match /patients/{pid}/{subcollection}/{doc=**} {
      allow read, write: if isPatient() && request.auth.uid == pid;
      allow read: if isStaff() && patientClinicId(pid) == clinicId();
      allow write: if isCoach() && patientClinicId(pid) == clinicId()
                   && !isConsentSubpath(subcollection);
      allow write: if isAdmin() && patientClinicId(pid) == clinicId()
                   && !isConsentSubpath(subcollection);
    }
    // مستند المريض نفسه: قراءة بقاعدة resource.data (لا get()) حتى
    // تُقبل استعلامات القائمة — قاعدة تعتمد على get() لا يمكن إثباتها
    // من قيود الاستعلام، فكانت القائمة مرفوضة رغم فراغ العيادة.
    // التعديل ما زال لا يسمح بتغيير clinicId.
    // الإنشاء: المريض نفسه فقط أثناء التسجيل بالدعوة (registerWithInvitation
    // ينشئ users/{uid} أولًا فيتحقق isPatient())، ولعيادته نفسها فقط،
    // وبحقول محدودة: clinicId وprofile وinvitedBy الاختياري. أي مفتاح
    // آخر (مثل plan) مرفوض. لا يوجد مسار في الكود ينشئ سجل مريض من
    // الطاقم، لذلك لا allow create للطاقم هنا. أي تعديل لاحق على هذا
    // الملف يحتاج نشرًا يدويًا للقواعد (بانتظار ذلك النشر في هذه المرحلة).
    match /patients/{pid} {
      allow read: if isPatient() && request.auth.uid == pid;
      allow read: if isStaff() && resource.data.clinicId == clinicId();
      allow create: if isPatient() && request.auth.uid == pid
                    && clinicId() is string
                    && request.resource.data.clinicId == clinicId()
                    && request.resource.data.profile is map
                    && request.resource.data.profile.clientName is string
                    && request.resource.data.profile.clientName.size() > 0
                    && request.resource.data.profile.clientName.size() < 200
                    && (request.resource.data.keys().hasOnly(['clinicId', 'profile'])
                        || (request.resource.data.keys().hasOnly(['clinicId', 'profile', 'invitedBy'])
                            && request.resource.data.invitedBy is string
                            && request.resource.data.invitedBy.size() > 0
                            && request.resource.data.invitedBy.size() < 200));
      allow update: if isStaff() && clinicId() == resource.data.clinicId
                    && request.resource.data.clinicId == resource.data.clinicId;
    }

    // الموافقات: المريض يمنح/يسحب موافقته، الطاقم يقرأ فقط.
    match /patients/{pid}/consents/{type} {
      allow read: if (isPatient() && request.auth.uid == pid)
                  || (isStaff() && patientClinicId(pid) == clinicId());
      allow write: if isPatient() && request.auth.uid == pid;
    }

    // سجل التدقيق: قراءة أدمن العيادة فقط، وكتابة خادم فقط (مرفوضة من العميل).
    match /clinicAudit/{cid}/events/{eid} {
      allow read: if isAdmin() && clinicId() == cid;
      allow write: if false;
    }

    // كل ما عداه: مرفوض.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
