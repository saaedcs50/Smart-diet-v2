// ============================================================================
// قواعد أمان Firestore — المرحلة الثالثة: نموذج B2B (اشتراك واحد للعيادة)
// ----------------------------------------------------------------------------
// حالة النشر: القواعد أدناه بانتظار النشر اليدوي على المشروع التجريبي
// smart-diet-platform-trial (انظر firestore.rules.test.md). أي تعديل لاحق
// يحتاج إعادة نشر يدوي. قواعد Storage غير منشورة — لا رفع سحابي في
// النموذج الحالي.
//
// نموذج B2B (محسوم 2026-10-31):
// - اشتراك واحد لكل عيادة كـ entity يغطي دكاترتها ومرضاهم (clinicSubscriptions)
// - الدفع من صاحب العيادة فقط (يدوي: انستاباي/فودافون كاش) — لا اشتراك
//   للمريض ولا للدكتور (أُلغيت patientSubscriptions وdoctorSubscriptions)
// - الأدوار: owner = صاحب المنصة (سعيد، يُنشأ من الكونسول، clinicId='platform')
//   وadmin = صاحب العيادة وcoach = الدكتور وpatient = المريض
// - انتهاء الاشتراك: 7 أيام سماح (grace) بتنبيهات ← إيقاف كامل (expired)
// - الإيقاف مطبّق في القواعد (هنا) + الواجهة (قرار #11)
//
// مبادئ: الرفض هو الافتراضي؛ لا وصول متقاطع بين العيادات؛ الدكتور لا يرى
// إلا مرضاه (invitedBy) — مطبّق في القواعد لا في الواجهة فقط؛ صاحب العيادة
// يرى كل مرضى عيادته؛ صاحب المنصة يدير العيادات والاشتراكات.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // مصدر الدور: مستند المستخدم نفسه (انظر ملاحظة المرحلة الثانية في
    // التاريخ أدناه). الحماية بوجود المستند: get() على مستند غير موجود
    // يُخطئ التقييم كله، لذلك تُستخدم exists() أولًا.
    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() { return userExists() ? userData().role : null; }
    function clinicId() { return userExists() ? userData().clinicId : null; }
    function isPatient() { return signedIn() && role() == 'patient'; }
    function isCoach() { return signedIn() && role() == 'coach'; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isStaff() { return isCoach() || isAdmin(); }
    function isPlatformOwner() { return signedIn() && role() == 'owner'; }

    // --- الاشتراك -----------------------------------------------------------
    // حالة اشتراك العيادة: active أو grace تعني "مسموح"، وغير ذلك (expired
    // أو غياب الوثيقة) تعني "موقوف". get() على وثيقة غائبة يُخطئ التقييم،
    // لذلك exists() أولًا (والتقييم الكسول يمنع الـ get عند عدم الوجود).
    function subExists(cid) {
      return exists(/databases/$(database)/documents/clinicSubscriptions/$(cid));
    }
    function subStatus(cid) {
      return get(/databases/$(database)/documents/clinicSubscriptions/$(cid)).data.status;
    }
    function clinicSubActive(cid) {
      return subExists(cid)
        && (subStatus(cid) == 'active' || subStatus(cid) == 'grace');
    }

    function patientClinicId(pid) {
      return get(/databases/$(database)/documents/patients/$(pid)).data.clinicId;
    }
    function patientInvitedBy(pid) {
      let pdata = get(/databases/$(database)/documents/patients/$(pid)).data;
      return 'invitedBy' in pdata ? pdata.invitedBy : null;
    }

    // هل أول مقطع تحت المريض هو consents؟ تُستخدم لمنع كتابة الطاقم
    // على الموافقات عبر الممرر العام، لأن القواعد OR فيتجاوز allow write
    // العام قاعدة الموافقات الأضيق.
    // (المقطع يُمرر كمعامل لأن الدوال لا ترى متغيرات الـ match خارج نطاق تعريفها.)
    function isConsentSubpath(firstSegment) {
      return firstSegment == 'consents';
    }

    // --- الدعوات ------------------------------------------------------------
    function invitationExists() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invitations/$(request.auth.token.email));
    }
    function invitationData() {
      return get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data;
    }
    function invitationAllows(uid) {
      return signedIn() && request.auth.uid == uid && invitationExists()
        && invitationData().email == request.auth.token.email
        && invitationData().status == 'pending'
        && invitationData().role == request.resource.data.role
        && invitationData().clinicId == request.resource.data.clinicId;
    }

    // --- العيادات -----------------------------------------------------------
    // القراءة: أعضاء العيادة + صاحب المنصة. الإنشاء: صاحب المنصة فقط.
    // التعديل: صاحب المنصة كاملًا؛ صاحب العيادة على أي حقل عدا status
    // وownerUid (لا يستطيع تغيير حالة الإيقاف ولا نقل الملكية).
    match /clinics/{cid} {
      allow read: if isPlatformOwner() || (signedIn() && clinicId() == cid);
      allow create: if isPlatformOwner();
      // صاحب العيادة لا يغيّر status ولا ownerUid — المقارنة عبر get()
      // الآمنة لأن الحقل قد يغيب من أحد الطرفين في بعض التحديثات.
      allow update: if isPlatformOwner()
                    || (isAdmin() && clinicId() == cid
                        && request.resource.data.get('status', null)
                           == resource.data.get('status', null)
                        && request.resource.data.get('ownerUid', null)
                           == resource.data.get('ownerUid', null));
      allow delete: if false;
    }

    // --- اشتراكات العيادات --------------------------------------------------
    // القراءة: صاحب المنصة + طاقم العيادة (حتى لو منتهي — صاحب العيادة
    // يحتاج رؤية حالة التجديد). الكتابة: صاحب المنصة فقط، ما عدا إلحاق
    // طلب دفع جديد من صاحب العيادة (إضافة واحدة بنهاية payments، بلا
    // تعديل على المدفوعات السابقة ولا على باقي الحقول).
    function isValidPaymentAppend() {
      let oldPayments = resource.data.get('payments', []);
      let newPayments = request.resource.data.get('payments', []);
      // حقلان فقط يتغيران: payments وupdatedAt
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['payments', 'updatedAt'])
        // عنصر واحد يُلحق بالنهاية، والسابقة كما هي
        && newPayments.size() == oldPayments.size() + 1
        && newPayments.removeAll(oldPayments).size() == 1
        // بنية الطلب الجديد سليمة وغير مراجَع
        && isValidNewPayment(newPayments[newPayments.size() - 1]);
    }
    function isValidNewPayment(p) {
      return p.method in ['instapay', 'vodafone_cash']
        && p.amount is number && p.amount > 0
        && p.reference is string && p.reference.size() > 0
             && p.reference.size() < 100
        && (!('reviewedAt' in p) || p.reviewedAt == null)
        && (!('reviewedBy' in p) || p.reviewedBy == null);
    }
    match /clinicSubscriptions/{sid} {
      allow read: if isPlatformOwner() || (isStaff() && clinicId() == sid);
      allow write: if isPlatformOwner();
      allow update: if isAdmin() && clinicId() == sid && isValidPaymentAppend();
    }

    // --- إعدادات المنصة -----------------------------------------------------
    // قراءة: أي مسجّل (بيانات الدفع تظهر لصاحب العيادة). كتابة: صاحب المنصة.
    match /platformConfig/{doc} {
      allow read: if signedIn();
      allow write: if isPlatformOwner();
    }

    // --- سجل الحساب ----------------------------------------------------------
    // القراءة: صاحبه، طاقم عيادته، صاحب المنصة (للوحة /owner).
    // الإنشاء: أدمن العيادة (باشتراك ساري) أو المدعو عبر دعوة مطابقة.
    // التعديل: أدمن العيادة (بلا تغيير دور/عيادة) أو صاحب المنصة كاملًا.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || (isStaff() && resource.data.clinicId == clinicId())
        || isPlatformOwner());
      allow create: if (isAdmin() && request.resource.data.clinicId == clinicId()
                     && clinicSubActive(clinicId()))
                    || invitationAllows(uid);
      allow update: if isAdmin() && clinicId() == resource.data.clinicId
                    && request.resource.data.clinicId == resource.data.clinicId
                    && request.resource.data.role == resource.data.role;
      allow update: if isPlatformOwner();
      allow delete: if false;
    }

    // --- الدعوات ------------------------------------------------------------
    // الإنشاء حسب الدور (B2B):
    // - صاحب المنصة: يدعو صاحب عيادة (admin) لعيادة موجودة فقط
    // - صاحب العيادة: يدعو دكتور (coach) أو مريض (patient) — لا admin جديد
    // - الدكتور: يدعو مريض فقط
    // إنشاء الطاقم يشترط اشتراكًا ساريًا (لا توسعة لعيادة موقوفة).
    // الاستهلاك/إعادة الفتح كما في المرحلة الثانية + صاحب المنصة.
    match /invitations/{invId} {
      allow read: if signedIn() && (request.auth.token.email == resource.data.email
        || (isStaff() && resource.data.clinicId == clinicId())
        || isPlatformOwner());
      allow create: if (isPlatformOwner()
                     && request.resource.data.role == 'admin'
                     && request.resource.data.status == 'pending'
                     && invId == request.resource.data.email
                     && exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)))
                    || (isAdmin() && request.resource.data.clinicId == clinicId()
                     && (request.resource.data.role == 'coach'
                         || request.resource.data.role == 'patient')
                     && request.resource.data.status == 'pending'
                     && invId == request.resource.data.email
                     && clinicSubActive(clinicId()))
                    || (isCoach() && request.resource.data.clinicId == clinicId()
                     && request.resource.data.role == 'patient'
                     && request.resource.data.status == 'pending'
                     && invId == request.resource.data.email
                     && clinicSubActive(clinicId()));
      allow update: if (
                      signedIn()
                      && resource.data.status == 'pending'
                      && request.resource.data.status == 'consumed'
                      && request.auth.token.email == resource.data.email
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    ) || (
                      (isStaff() || isPlatformOwner())
                      && resource.data.clinicId == clinicId()
                      && resource.data.status == 'consumed'
                      && request.resource.data.status == 'pending'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    );
      allow delete: if false;
    }

    // --- المريض وكل ما تحته --------------------------------------------------
    // كل قراءة/كتابة تشترط اشتراكًا ساريًا للعيادة (active/grace) — هذا هو
    // "الإيقاف الكامل" عند انتهاء السماح (قرار #11: القواعد + الواجهة).
    // نطاق الدكتور: مرضاه فقط (invitedBy == uid) — في القواعد لا الواجهة فقط.
    // ملاحظة الممرر العام {doc=**} من المرحلة الثانية ما زالت سارية: النمط
    // {subcollection}/{doc=**} يستبعد مستند المريض نفسه.
    match /patients/{pid}/{subcollection}/{doc=**} {
      allow read, write: if isPatient() && request.auth.uid == pid
                         && clinicSubActive(clinicId());
      allow read: if isAdmin() && patientClinicId(pid) == clinicId()
                  && clinicSubActive(clinicId());
      allow read: if isCoach() && patientClinicId(pid) == clinicId()
                  && patientInvitedBy(pid) == request.auth.uid
                  && clinicSubActive(clinicId());
      allow write: if isAdmin() && patientClinicId(pid) == clinicId()
                   && !isConsentSubpath(subcollection)
                   && clinicSubActive(clinicId());
      allow write: if isCoach() && patientClinicId(pid) == clinicId()
                   && patientInvitedBy(pid) == request.auth.uid
                   && !isConsentSubpath(subcollection)
                   && clinicSubActive(clinicId());
    }
    // مستند المريض نفسه: قراءة بقاعدة resource.data (لا get()) حتى تُقبل
    // استعلامات القائمة — الدرس المُثبت في المرحلة الثانية.
    // الإنشاء: المريض نفسه بالدعوة + اشتراك ساري + الحقول المحدودة.
    match /patients/{pid} {
      allow read: if isPatient() && request.auth.uid == pid
                  && clinicSubActive(clinicId());
      allow read: if isAdmin() && resource.data.clinicId == clinicId()
                  && clinicSubActive(clinicId());
      allow read: if isCoach() && resource.data.clinicId == clinicId()
                  && resource.data.invitedBy == request.auth.uid
                  && clinicSubActive(clinicId());
      allow create: if isPatient() && request.auth.uid == pid
                    && clinicId() is string
                    && clinicSubActive(clinicId())
                    && request.resource.data.clinicId == clinicId()
                    && request.resource.data.profile is map
                    && request.resource.data.profile.clientName is string
                    && request.resource.data.profile.clientName.size() > 0
                    && request.resource.data.profile.clientName.size() < 200
                    && (request.resource.data.keys().hasOnly(['clinicId', 'profile'])
                        || (request.resource.data.keys().hasOnly(['clinicId', 'profile', 'invitedBy'])
                            && request.resource.data.invitedBy is string
                            && request.resource.data.invitedBy.size() > 0
                            && request.resource.data.invitedBy.size() < 200));
      allow update: if isAdmin() && clinicId() == resource.data.clinicId
                    && request.resource.data.clinicId == resource.data.clinicId
                    && clinicSubActive(clinicId());
      allow update: if isCoach() && clinicId() == resource.data.clinicId
                    && resource.data.invitedBy == request.auth.uid
                    && request.resource.data.clinicId == resource.data.clinicId
                    && clinicSubActive(clinicId());
    }

    // الموافقات: المريض يمنح/يسحب، الطاقم يقرأ — الكل باشتراك ساري،
    // والدكتور لمرضاه فقط.
    match /patients/{pid}/consents/{type} {
      allow read: if isPatient() && request.auth.uid == pid
                  && clinicSubActive(clinicId());
      allow read: if isAdmin() && patientClinicId(pid) == clinicId()
                  && clinicSubActive(clinicId());
      allow read: if isCoach() && patientClinicId(pid) == clinicId()
                  && patientInvitedBy(pid) == request.auth.uid
                  && clinicSubActive(clinicId());
      allow write: if isPatient() && request.auth.uid == pid
                   && clinicSubActive(clinicId());
    }

    // سجل التدقيق: قراءة أدمن العيادة + صاحب المنصة، كتابة خادم فقط.
    match /clinicAudit/{cid}/events/{eid} {
      allow read: if (isAdmin() && clinicId() == cid) || isPlatformOwner();
      allow write: if false;
    }

    // كل ما عداه: مرفوض.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
