# انسخ إلى .env للتطوير المحلي. لا ترفع ملف .env الحقيقي.
# أسرار خادم التطبيق — تحفظ في إعدادات بيئة الخادم فقط.
COACH_PIN=
SESSION_SECRET=

# حدّ محاولات PIN الدائم (اختياري).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# إعدادات Supabase العامة التي تُستخدم داخل المتصفح.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# مفتاح VAPID العام فقط — ليس سرًا. المفتاح الخاص لا يوضع في VITE_* مطلقًا.
VITE_VAPID_PUBLIC_KEY=

# يظل وضع المنصة معطّلًا ما لم يُفعّل صراحة.
VITE_PLATFORM_ENABLED=false

# إعدادات توقيع Web Push تحفظ في Supabase Vault (وليست متغيرات بيئة في الواجهة):
# smart_diet_vapid_public_key / smart_diet_vapid_private_key / smart_diet_vapid_subject
# المتصفح يحصل فقط على المفتاح العام عبر VITE_VAPID_PUBLIC_KEY.
