# انسخ إلى .env للتطوير المحلي — لا ترفع .env الحقيقي
# اختر رمز PIN خاصًا بك (5 أرقام على الأقل) — لا توجد رموز افتراضية في الإنتاج، وغياب هذا المتغير في الإنتاج يوقف الإقلاع
COACH_PIN=
# سر توقيع الجلسات: سلسلة عشوائية طويلة (32 حرفًا على الأقل)، فريدة لكل نسخة/عيادة
SESSION_SECRET=
# حدّ محاولات الـ PIN الدائم عبر Upstash Redis REST (اختياري — اتركهما فارغين للوضع الافتراضي).
# بدونهما يعمل الحد في ذاكرة كل نسخة فقط، وهو غير فعّال عبر نسخ Vercel المتعددة.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# لا تضبط GEMINI_API_KEY لهذا التطبيق — غير موصول بأي استدعاء في src

# إعدادات تطبيق ويب Firebase للمشروع التجريبي المنفصل (وضع المنصة فقط).
# القيم الحقيقية للمشروع التجريبي تُضبط في .env المحلي أو في بيئة النشر فقط
# — لا تضع أي قيمة حقيقية هنا، ولا ترفع .env أبدًا. بلا هذه المتغيرات تعمل
# الاختبارات والبناء، لكن عمليات المنصة الفعلية لن تعمل حتى تُضبط.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# FCM (المرحلة 6): مفتاح VAPID من Firebase Console ← Cloud Messaging،
# ورابط الـ Worker المنشور على Cloudflare
VITE_FCM_VAPID_KEY=
VITE_FCM_WORKER_URL=

# Supabase (ترحيل 2026-10-31 — بديل Firebase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
