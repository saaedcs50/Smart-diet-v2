# انسخ إلى .env للتطوير المحلي. لا ترفع ملف .env الحقيقي.
# أسرار خادم التطبيق — تحفظ في إعدادات بيئة الخادم فقط.
COACH_PIN=
SESSION_SECRET=

# حدّ محاولات PIN الدائم (اختياري).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# إعدادات Supabase العامة التي تُستخدم داخل المتصفح.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# مفتاح VAPID العام فقط — ليس سرًا. المفتاح الخاص لا يوضع في VITE_* مطلقًا.
VITE_VAPID_PUBLIC_KEY=

# يظل وضع المنصة معطّلًا ما لم يُفعّل صراحة.
VITE_PLATFORM_ENABLED=false

# أسرار وظيفة الإشعارات في Supabase:
# VAPID_PRIVATE_KEY
# VAPID_SUBJECT

# فعّل أزرار Google فقط بعد إعداد Provider وCallback في Supabase وGoogle Cloud.
# القيمة الافتراضية الآمنة false لأن Google OAuth غير مفعّل في المشاريع الحالية.
VITE_GOOGLE_OAUTH_ENABLED=false
