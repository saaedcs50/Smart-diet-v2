# انسخ إلى .env للتطوير المحلي — لا ترفع .env الحقيقي
# اختر رمز PIN خاصًا بك (5 أرقام على الأقل) — لا توجد رموز افتراضية في الإنتاج، وغياب هذا المتغير في الإنتاج يوقف الإقلاع
COACH_PIN=
# سر توقيع الجلسات: سلسلة عشوائية طويلة (32 حرفًا على الأقل)، فريدة لكل نسخة/عيادة
SESSION_SECRET=
# GEMINI_API_KEY=

# إعدادات تطبيق ويب Firebase للمشروع التجريبي المنفصل (وضع المنصة فقط).
# القيم الحقيقية للمشروع التجريبي تُضبط في .env المحلي أو في بيئة النشر فقط
# — لا تضع أي قيمة حقيقية هنا، ولا ترفع .env أبدًا. بلا هذه المتغيرات تعمل
# الاختبارات والبناء، لكن عمليات المنصة الفعلية لن تعمل حتى تُضبط.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
