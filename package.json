{
  "name": "smart-diet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "brand": "node scripts/apply-brand.mjs",
    "new-client": "node scripts/new-client.mjs",
    "predev": "node scripts/apply-brand.mjs",
    "dev": "tsx server.ts",
    "prebuild": "node scripts/apply-brand.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint src api server.ts vite.config.ts",
    "lint:types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "dompurify": "^3.4.17"
  },
  "description": "Smart Diet — منصة متابعة تغذية White-Label للعيادات (PWA)",
  "engines": {
    "node": ">=20"
  }
}
